# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed: the OSV Scan and Security Audit CI jobs scan it,
# and a missing lockfile fails them.

# WASM
/pkg/
*.wasm

# xtask (standalone crate, has its own target dir)
/xtask/target/
/xtask/Cargo.lock

# Node
node_modules/
bindings/ts/dist/
bindings/ts/pkg/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Coverage
*.profraw
lcov.info
tarpaulin-report.html

# Benchmark results
/bench-results/

# mdBook
/book/book/

# Per-agent local state (tool-specific, never committed)
#
# Committed agent config is vendor-neutral and lives in `.agents/`:
#   .agents/skills/   Agent Skills (SKILL.md per skill)
#   .agents/notes/    Agent Notes (decision records)
# Agent Skills are an open standard read by many tools, so they are versioned
# here on purpose. What follows is per-tool scratch state, listed per vendor so
# a new tool does not silently start committing its working files.
.claude/agent-memory-local/
.claude/worktrees/
.claude/research/
.claude/*.md
!.claude/settings.json
.claude/scheduled_tasks.lock
.cursor/
# End per-agent local state

# Git worktrees
.worktrees/

# Tool run artifacts (regenerated by the scripts that create them)
/tmp/
out-publish-*.json

# Internal docs (prevent accidental commits)
*-INTERNAL.md
ISSUES-*.md
ROADMAP.md
